      "expect": 200
    },
    {
      "id": "blog-upstream",
      "name": "blog 容器",
      "url": "http://127.0.0.1:8081/",
      "group": "内部",
      "expect": 200
    },
    {
      "id": "ssq-upstream",
      "name": "ssq-assistant 容器",
      "url": "http://127.0.0.1:8082/api/health",
      "group": "内部",
      "expect": 200
    }
  ]
}
