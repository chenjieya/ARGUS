# ── ARGUS 运行配置 ──────────────────────────────────────────
PORT=8848
HOST=0.0.0.0

# 页面访问口令（留空 = 不启用 Basic 认证）
AUTH_USER=
AUTH_PASS=

# Docker（挂载 docker.sock 后自动可用；远端可写 tcp://ip:2375）
DOCKER_SOCKET=/var/run/docker.sock

# 宿主机 /proc（容器内挂 /proc:/host/proc 后可读到真实宿主机指标）
HOST_PROC=/host/proc

# nginx 配置与日志目录（容器内挂载点）
NGINX_CONF_DIR=/etc/nginx-src
NGINX_LOG_DIR=/var/log/nginx-src

# 宿主机上 nginx 配置 / 日志的真实路径（compose 卷挂载用）
# 你这台机器是原生安装的 nginx，站点配置在 conf.d 下，不是容器
NGINX_CONF_HOST=/etc/nginx/conf.d
NGINX_LOG_HOST=/var/log/nginx

# 磁盘监测挂载点，逗号分隔
DISK_PATHS=/host

# 采集节奏（毫秒）
METRIC_INTERVAL=2000
DOCKER_INTERVAL=5000
PROBE_INTERVAL=20000
NGINX_INTERVAL=30000

# 历史点数（2s 一点 × 900 = 30 分钟）
HISTORY_SIZE=900

# 探测超时 / 失败几次判定宕机
PROBE_TIMEOUT=8000
FAIL_THRESHOLD=2

# 告警：通用 Webhook（POST JSON，留空不推送）
ALERT_WEBHOOK=
ALERT_COOLDOWN=300000

# 断线 / 证书 / 容量阈值
TLS_WARN_DAYS=14
CPU_WARN=90
MEM_WARN=92
DISK_WARN=90
